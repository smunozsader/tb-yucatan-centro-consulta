# Firebase Service Account Configuration
# Copy this file to .env and fill in your values

# Path to your service account key JSON file
FIREBASE_SERVICE_ACCOUNT_KEY=C:\Users\smuno\FirebaseKeys\ceso-aphis-yuc-service-account.json

# Alternative: Base64 encoded key (for environments that don't support file paths)
# FIREBASE_SERVICE_ACCOUNT_KEY_B64=YOUR_BASE64_ENCODED_KEY_HERE

# Firebase Project Configuration
FIREBASE_PROJECT_ID=ceso-aphis-yuc
FIREBASE_PRIVATE_KEY_ID=your_key_id_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ceso-aphis-yuc.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id_here
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs