rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------------
    // Simple, easy-to-read ruleset for the TB Yucatán app
    // - Public reads for agreements and evidence metadata (so the public UI can list)
    // - Writes (create/update) allowed only for authenticated users with custom
    //   claims: role == 'RESPONSABLE' or admin == true
    // - Admins can delete; clients cannot delete documents directly
    // ---------------------------------------------------------------------



    // --------------------------- Movilizaciones -------------------------------
    // Movilizaciones data: public read for summary/reporting, writes only by ADMINISTRATOR or RESPONSIBLE
    match /movilizaciones/{ventanilla}/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isResponsible();
    }

    // ---------------------------------------------------------------------
    // Simple, easy-to-read ruleset for the TB Yucatán app
    // - Public reads for agreements and evidence metadata (so the public UI can list)
    // - Writes (create/update) allowed only for authenticated users with custom
    //   claims: role == 'RESPONSABLE' or admin == true
    // - Admins can delete; clients cannot delete documents directly
    // ---------------------------------------------------------------------

    function isAuthenticated() { return request.auth != null; }
    function isAdmin() { return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.role == 'ADMINISTRATOR'); }
    function isResponsible() { return isAuthenticated() && request.auth.token.role == 'RESPONSABLE'; }

    // --------------------------- Agreements -------------------------------
    // CESO agreements: public reads, writes by RESPONSABLE or admin
    match /acuerdos-ceso/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() || isResponsible();
      allow delete: if isAdmin();
    }

    // APHIS agreements: public reads, writes by RESPONSABLE or admin
    match /acuerdos-aphis/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() || isResponsible();
      allow delete: if isAdmin();
    }

    // --------------------------- Users ----------------------------------
          // --------------------------- Movilizaciones -------------------------------
          // Movilizaciones data: public read for summary/reporting, writes only by ADMINISTRATOR or RESPONSIBLE
          match /movilizaciones/{ventanilla}/{docId} {
            allow read: if true;
            allow create, update, delete: if isAdmin() || isResponsible();
          }
    // Users collection: readable by authenticated users; creation/deletion only by admin
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      // Users may update their own profile; admins may update any user
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Org-specific user collections used by the client (users_ceso, users_aphis)
    // Allow authenticated reads so the client can load the user list for UI purposes.
    // Creation and updates remain restricted to admins or the user themselves.
    match /users_ceso/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /users_aphis/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // --------------------------- Evidencias -----------------------------
    // Evidence metadata stored as a subcollection under each agreement:
    //   /acuerdos-ceso/{docId}/evidencias/{evidId}
    // Public read so that listings work without auth; creating evidence metadata
    // requires authentication and a matching uploader email.
    match /{collection}/{docId}/evidencias/{evidId} {
      allow read: if true;

      allow create: if isAdmin() || (isResponsible() &&
        // basic shape validation
        request.resource.data.keys().hasAll(['filename','storagePath','uploader','createdAt'])
        && request.resource.data.filename is string
        && request.resource.data.storagePath is string
        && request.resource.data.uploader is string
        && request.resource.data.createdAt is timestamp

        // uploader must match authenticated user's email (prevent forging)
        && request.resource.data.uploader == request.auth.token.email
      );

      // Only admins may update or delete evidence metadata from the client-side
      allow update, delete: if isAdmin();
    }

    // --------------------------- Repositorio ----------------------------
    // Repository files metadata: read-by-all, writes only by admin
    match /repositorio-ceso/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /repositorio-aphis/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Default deny for anything not explicitly allowed above (writes are denied)
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }

}
