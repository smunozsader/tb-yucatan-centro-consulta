rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Restrict read access to authenticated users only.
    // If you need public reads for some collections, add explicit exceptions.
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // Users collections - allow read access for authentication
    match /users_ceso/{userId} {
      // Users list is only readable by authenticated users
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    match /users_aphis/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Consolidated users collection (if used in future)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Agreement documents - CESO
    // Writes are restricted to authenticated users with appropriate custom claims
    // or performed via a trusted backend service using the Admin SDK.
    match /acuerdos-ceso/{docId} {
  // Read access restricted to authenticated users
  allow read: if request.auth != null;
      // Allow create/update only for authenticated users with role 'RESPONSABLE' or admin claim
      allow create: if request.auth != null && (
        request.auth.token.role == 'RESPONSABLE' || request.auth.token.admin == true
      );
      allow update: if request.auth != null && (
        request.auth.token.role == 'RESPONSABLE' || request.auth.token.admin == true
      );
      allow delete: if false;
    }

    // Agreement documents - APHIS
    // Writes are restricted to authenticated users with appropriate custom claims
    // or performed via a trusted backend service using the Admin SDK.
    match /acuerdos-aphis/{docId} {
      allow read: if true;
      allow create: if request.auth != null && (
        request.auth.token.role == 'RESPONSABLE' || request.auth.token.admin == true
      );
      allow update: if request.auth != null && (
        request.auth.token.role == 'RESPONSABLE' || request.auth.token.admin == true
      );
      allow delete: if false;
    }

    // Repository documents - CESO specific
    // Prefer authenticated writes; if using application-level auth (gobmxAuth), use a
    // backend service to create/modify these documents via Admin SDK instead of allowing
    // unauthenticated client writes.
    match /repositorio-ceso/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.admin == true
        && request.resource.data.keys().hasAll(['category','title','filename','storagePath','uploader','createdAt'])
        && request.resource.data.category is string
        && request.resource.data.title is string
        && request.resource.data.filename is string
        && request.resource.data.storagePath is string
        && request.resource.data.uploader is string;
      // Allow update only for admins (prevent arbitrary client-side updates)
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if false;
    }

    // Repository documents - APHIS specific
    match /repositorio-aphis/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.admin == true
        && request.resource.data.keys().hasAll(['category','title','filename','storagePath','uploader','createdAt'])
        && request.resource.data.category is string
        && request.resource.data.title is string
        && request.resource.data.filename is string
        && request.resource.data.storagePath is string
        && request.resource.data.uploader is string;
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if false;
    }

    // Evidencias subcollection: metadata describing uploaded evidence files
    match /{coll}/{docId}/evidencias/{evidId} {
      // Anyone may read evidence metadata (public), but creating evidence metadata
      // requires authentication. Also ensure uploader matches the authenticated user.
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['filename','storagePath','uploader','createdAt'])
        && request.resource.data.filename is string
        && request.resource.data.storagePath is string
        && request.resource.data.uploader is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.uploader == request.auth.token.email;

      // Disallow updates/deletes from clients; handle via admin processes if needed.
      allow update, delete: if false;
    }
  }
}
