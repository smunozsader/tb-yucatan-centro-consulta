{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": [
    {
      "bucket": "ceso-aphis-yuc.appspot.com",
      "target": "default",
      "rules": "storage.rules"
    }
  ],
  "emulators": {
    "firestore": { "host": "localhost", "port": 8080 },
    "storage": { "host": "localhost", "port": 9199 },
    "auth": { "host": "localhost", "port": 9099 }
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".tmp.driveupload/**",
      ".tmp/**",
      "ceso.html",
      "aphis.html"
      ,"*.log",
      "deploy-debug.log"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/admin-upload",
        "function": "adminUpload"
      },
      { "source": "/hall-ceso", "destination": "/hall-ceso.html" },
      { "source": "/hall-aphis", "destination": "/hall-aphis.html" },
      { "source": "/centro-ayuda", "destination": "/centro-ayuda.html" },
      { "source": "/repositorio-ceso", "destination": "/repositorio-ceso.html" },
      { "source": "/repositorio-aphis", "destination": "/repositorio-aphis.html" },
      { "source": "/batch-upload-ceso", "destination": "/batch-upload-ceso.html" },
  { "source": "/batch-upload-aphis", "destination": "/batch-upload-aphis.html" },
  { "source": "/acuerdos-ceso", "destination": "/acuerdos-ceso.html" },
  { "source": "/acuerdos-ceso.html", "destination": "/acuerdos-ceso.html" },
  { "source": "/acuerdos-aphis", "destination": "/acuerdos-aphis.html" },
  { "source": "/acuerdos-aphis.html", "destination": "/acuerdos-aphis.html" },
  { "source": "/favicon.ico", "destination": "/favicon.ico" }
    ]
  }
}
